# PurrSight — environment variables (COPY, DON'T COMMIT SECRETS)
# ---------------------------------------------------------------------------
# This file is the SINGLE SOURCE OF TRUTH for env var NAMES (gap #3).
#   - B (lib/assess/client.ts) reads exactly these names.
#   - A sets exactly these names in Azure App Service > Configuration.
# If a name changes here, both people update together. Never commit real keys;
# .gitignore already excludes .env*.
#
# Local dev:  copy to `.env.local`  ->  `cp .env.example .env.local`
# ---------------------------------------------------------------------------

# Which provider client.ts talks to. Lets local dev run on a plain OpenAI or
# GitHub Models key (Phase -1 fallback) and swap to Azure at deploy time
# without touching code.
#   azure  | openai | github
MODEL_PROVIDER=azure

# --- Azure OpenAI (production / MODEL_PROVIDER=azure) -----------------------
# Endpoint of your Azure OpenAI resource (NOT the full /chat/completions URL).
# An "Azure AI Services" (AIServices) resource — what docs/MODEL-ACCESS.md
# provisions — uses .cognitiveservices.azure.com. A classic "Azure OpenAI"
# resource uses .openai.azure.com. Copy whichever `az` reports; both work.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
# AUTH: two options — pick one.
#   (a) Managed Identity (PREFERRED). @azure/identity is a dependency, so
#       client.ts can use DefaultAzureCredential — leave AZURE_OPENAI_API_KEY
#       BLANK, enable a system-assigned identity on the App Service, and grant
#       it the "Cognitive Services OpenAI User" role on the OpenAI resource.
#       Locally, `az login` provides the credential automatically.
#   (b) API key. Paste it below; acceptable for the hackathon. Never commit it.
AZURE_OPENAI_API_KEY=
# The DEPLOYMENT NAME you created for a vision-capable model. Phase -1 settled
# on gpt-4.1 (+ strict structured outputs) — see docs/MODEL-ACCESS.md. This is
# your deployment name, which may differ from the model name.
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
# API version that supports vision + structured outputs. 2025-01-01-preview is
# REQUIRED for strict structured outputs (json_schema + strict:true) — see
# docs/MODEL-ACCESS.md. Older versions silently ignore `strict`.
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# --- Plain OpenAI (local fallback / MODEL_PROVIDER=openai) ------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- GitHub Models (local fallback / MODEL_PROVIDER=github) -----------------
# Endpoint: https://models.inference.ai.azure.com  — auth via a GitHub PAT.
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=gpt-4.1

# --- Pipeline tuning (optional; sensible defaults live in code) -------------
# Hard timeout for a single model call, milliseconds.
ASSESS_TIMEOUT_MS=20000

# --- Cost estimation (optional) ---------------------------------------------
# Used ONLY to print an estimated dollar cost in the server logs; nothing here
# affects behaviour. Defaults are gpt-4.1 Global Standard list prices, in USD
# per 1,000,000 tokens. Override if your region or agreement differs, or when
# prices change — no code edit or redeploy needed.
# NOTE: cached input is a discounted re-read of a repeated prompt prefix, and
# those tokens are a SUBSET of the input count, not an addition to it.
ASSESS_PRICE_INPUT_PER_1M=2.00
ASSESS_PRICE_CACHED_INPUT_PER_1M=0.50
ASSESS_PRICE_OUTPUT_PER_1M=8.00

# --- Vets-near-me map (optional) --------------------------------------------
# Enables the "Show vets near me" lookup in "What we recommend". The client id
# below is PRE-FILLED and is NOT a secret — it only names which Maps account to
# bill. You must ALSO hold the "Azure Maps Data Reader" role on that account
# (docs/LOCAL-SETUP.md §6); without it the lookup fails and the UI falls back
# to a plain Google Maps link. Blank both values to turn the feature off
# entirely — nothing breaks and the demo is unaffected.
#
# Backed by Azure Maps (resource: purrsight-maps). Unlike the model vars above
# there is NO NEXT_PUBLIC_ variant here, and that is the whole point: an Azure
# Maps subscription key CANNOT be restricted by HTTP referrer, so a key in the
# browser is a key that bills this subscription for anyone who copies it. The
# search and the map render both happen server-side in /api/vets; the browser
# only ever receives finished results.
#
# AUTH: two options — pick one, same shape as Azure OpenAI above.
#   (a) Managed Identity (PREFERRED, and what the pre-filled value assumes).
#       Leave AZURE_MAPS_SUBSCRIPTION_KEY BLANK — AZURE_MAPS_CLIENT_ID is
#       already set below.
#       Grant the principal the "Azure Maps Data Reader" role on the Maps
#       account — the App Service's system-assigned identity in production,
#       and your own user locally, where `az login` supplies the credential.
#   (b) Subscription key. Paste it below; acceptable for the hackathon. When a
#       key is set, it wins and AZURE_MAPS_CLIENT_ID is ignored.
#
# The account's uniqueId — NOT the resource name, and not a secret. Required
# for (a); without it the data plane cannot tell which account to bill and
# returns an opaque 401. Rediscover it with:
#   az maps account show -n purrsight-maps -g purrsight --query properties.uniqueId -o tsv
AZURE_MAPS_CLIENT_ID=4c54d1e5-05bb-453f-9548-e17fa69a83ca
AZURE_MAPS_SUBSCRIPTION_KEY=
#
# DEPLOYMENT: both are read at runtime on the server, so unlike a NEXT_PUBLIC_
# value they belong in App Service > Configuration alongside everything else in
# this file. Nothing needs to be present at build time.
